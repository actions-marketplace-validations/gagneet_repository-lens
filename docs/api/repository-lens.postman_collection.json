{
  "info": {
    "name": "Repository Lens API",
    "description": "Start repolens serve, set base_url and api_token in the environment, then run requests in order. No source path or credential is embedded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health",
        "description": "Check service availability without disclosing repository details.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Capabilities",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/v1/capabilities",
        "description": "Read the implemented scope and its limitations."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Scan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/v1/analysis",
        "description": "Scan the configured checkout. Incomplete results remain available with complete=false.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"max_file_bytes\": 2000000,\n  \"max_files\": 10000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Analysis",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/v1/analysis",
        "description": "Read the most recent scan held in this process; restarting clears it."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Query Impact",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/v1/impact",
        "description": "Query stored graph evidence without reading or executing target source.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"list_items\",\n  \"max_nodes\": 30\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Export Report",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/v1/report?format=mermaid&max_nodes=30",
        "description": "Export a bounded Mermaid/Markdown view or the full normalized SARIF findings."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}
