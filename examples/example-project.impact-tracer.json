{
  "exclude_paths": [
    "_archive",
    "backend/alembic/versions",
    "backend/backups",
    "docs/archive",
    "frontend/public"
  ],
  "aliases": {
    "order total": [
      "invoice total",
      "basket total",
      "amount due"
    ],
    "effective role": [
      "role elevation",
      "temporary elevation",
      "permission role"
    ],
    "overdue stage": [
      "reminder stage",
      "collection stage",
      "days overdue"
    ]
  },
  "artifacts": {
    "canonical_owners": "docs/architecture/canonical_owners.json",
    "router_datastore": "docs/architecture/router_datastore_map.json"
  },
  "client_api_base": "/api",
  "max_ambiguous_targets": 12,
  "max_file_bytes": 2000000,
  "_note_exclude_paths": "_archive holds an old copy of the application, including a virtualenv under a directory not named `venv`, so the default excludes do not match it."
}
